# Copy this file to .env and fill it in. .env is ignored by git: never commit real keys.
# Every value may be left empty: the app then uses a local SQLite file, simple rules instead of AI, and sends no emails.

# Supabase: Connect > Session pooler > connection string (put your database password in it)
DATABASE_URL=

# Any long random text (signs the login tokens)
SECRET_KEY=
# Password for the admin account (admin@client.test) created on the first start. Empty means demo123.
ADMIN_PASSWORD=
# 1 adds sample students and mentors to an empty database
LOAD_DEMO_DATA=1

# OpenAI: Smart Match and Pulse review
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Brevo: emails. EMAIL_FROM must be a sender address you verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Mentor Connect

# Any long random text. The reminder job sends it in the X-Job-Secret header.
JOBS_SECRET=
