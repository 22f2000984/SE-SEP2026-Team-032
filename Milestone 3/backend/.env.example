# Copy this file to .env for local work. .env is ignored by git: never commit real keys.
# Supabase: Project settings > Database > Connection string (use the pooler "Session" or "Transaction" string).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
SECRET_KEY=change-me
LOAD_DEMO_DATA=1

# Sprint 2 (leave empty to run without them: simple rules and no real emails)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Mentor Connect
# Any long random text. The GitHub Actions reminder job sends it in the X-Job-Secret header.
JOBS_SECRET=
